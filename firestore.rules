rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /groups/{g} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leader == request.auth.uid;
      // leader can edit anything; others may only change the member list (join/leave)
      allow update: if request.auth != null && (resource.data.leader == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      match /locations/{u} {
        allow read: if request.auth.uid in get(/databases/$(db)/documents/groups/$(g)).data.members;
        allow write: if request.auth.uid == u
          && request.auth.uid in get(/databases/$(db)/documents/groups/$(g)).data.members;
      }
    }
  }
}
